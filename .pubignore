# Files that are not published to pub.dev.
# Note: when .pubignore exists, .gitignore is ignored for publishing,
# so the needed rules are repeated here.

.dart_tool/
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
doc/api/

# IDE
.idea/
*.iml

# Unused native plugin templates (this is a pure Dart/Flutter package)
/android/
/ios/
/linux/
/macos/
/windows/

# Example app build/platform artifacts
example/.dart_tool/
example/build/
example/pubspec.lock
example/ios/Flutter/
example/ios/Pods/
example/ios/.symlinks/
example/android/.gradle/
example/android/local.properties
example/*.iml

# Golden images (except the ones used as pub.dev screenshots)
test/goldens/*
!test/goldens/list_phone.png
!test/goldens/detail_ok.png
!test/goldens/stats_phone.png

# Source videos (the published demo is doc/demo.webp)
*.mov
*.mp4
