# See https://dart.dev/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
pubspec.lock

# Directory created by dartdoc
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Flutter tool tərəfindən yaradılan platform artefaktları
android/app/
android/.gradle/
android/local.properties
android/gradle-wrapper.jar
ios/Flutter/
ios/Pods/
ios/.symlinks/
linux/flutter/
macos/Flutter/
macos/Pods/
windows/flutter/
.symlinks/

# IDE
.idea/
*.iml
!logging_service.iml

# Example app
example/.dart_tool/
example/build/
example/ios/Flutter/
example/ios/Pods/
example/ios/.symlinks/
example/android/.gradle/
example/android/local.properties
example/macos/Flutter/
example/linux/flutter/
example/windows/flutter/
example/*.iml

# Golden şəkillər `--tags golden` ilə yenidən yaradılır
